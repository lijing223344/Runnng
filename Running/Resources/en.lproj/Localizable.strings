"mini_hurdle_title" = "Mini Hurdle Spacing";
"mini_hurdle_home_desc" = "Enter GT leg length to generate the 21-wicket spacing progression and layout points.";
"mini_hurdle_hero_title" = "Set mini-hurdle rhythm from GT height";
"mini_hurdle_desc" = "Measure GT leg length, then generate the 21-wicket progression. This is a sprint-training stride reference, not a medical leg-length diagnosis.";
"mini_hurdle_setup_title" = "Quick Setup";
"mini_hurdle_setup_subtitle" = "Enter GT leg length, set the final target spacing from Mann or Clark, then adjust from rhythm and landing quality.";
"mini_hurdle_measurement_title" = "Measure greater-trochanter height first";
"mini_hurdle_measurement_subtitle" = "Here, leg length means the vertical height from the superior greater trochanter to the standing surface. It estimates sprint-spacing reference, not inseam, and not a diagonal outside-leg measure.";
"mini_hurdle_measurement_definition_title" = "Track-training definition";
"mini_hurdle_measurement_definition_body" = "GT leg length = vertical height from the superior greater trochanter to the ground while standing. A bad landmark shifts the whole 21-wicket layout, so confirm the bony point before tuning spacing.";
"mini_hurdle_measurement_partner_title" = "Measure from the side with a coach";
"mini_hurdle_measurement_partner_body" = "The athlete stands naturally while the coach palpates from the side or side-rear. Avoid self-measuring while bending forward. Close-fitting shorts make the landmark easier to confirm.";
"mini_hurdle_measurement_cue_lateral_title" = "Palpate the lateral hip";
"mini_hurdle_measurement_cue_lateral_body" = "Use the iliac crest only as orientation, then slide down the lateral hip to the proximal femur's greater-trochanter region.";
"mini_hurdle_measurement_cue_rotation_title" = "Confirm with rotation";
"mini_hurdle_measurement_cue_rotation_body" = "Have the athlete gently rotate the hip in and out. The point that moves with the femur and can be found repeatedly is the GT landmark.";
"mini_hurdle_measurement_cue_vertical_title" = "Measure vertically";
"mini_hurdle_measurement_cue_vertical_body" = "Measure straight down from the GT point to the floor rather than tracing the thigh or shorts seam.";
"mini_hurdle_measurement_cue_repeat_title" = "Repeat both sides";
"mini_hurdle_measurement_cue_repeat_body" = "Measure each side 2-3 times. If the sides differ, re-check the landmark before the coach chooses the training value.";
"mini_hurdle_measurement_step_1" = "Have the athlete stand naturally with feet alongside each other, toes forward, knees relaxed but not bent, pelvis level, and weight even on both feet.";
"mini_hurdle_measurement_step_2" = "Stand to the side or side-rear, find the iliac crest first, then slide down the lateral hip so the higher pelvic rim is not mistaken for the greater trochanter.";
"mini_hurdle_measurement_step_3" = "Ask the athlete to gently internally and externally rotate the hip. The bony point that clearly turns under your fingers with the femur and can be found again repeatedly is the greater trochanter.";
"mini_hurdle_measurement_step_4" = "Measure vertically from the confirmed superior GT point to the ground. Keep the rod upright and avoid bent knees, lifted hips, toe rise, or a shifted stance.";
"mini_hurdle_measurement_backup_title" = "Backup check when palpation is unclear";
"mini_hurdle_measurement_backup_body" = "If standing palpation is unclear, have the athlete flex the knee to about 90 degrees and slowly internally rotate the hip to find when the greater trochanter becomes most prominent. Then return to natural standing for the formal measurement.";
"mini_hurdle_measurement_note_title" = "Lock in the landmark before the decimal";
"mini_hurdle_measurement_note_body" = "A misplaced GT point spreads error into every wicket. Common mistakes are using the iliac crest, measuring diagonally, standing crooked, or following a shorts seam as the measurement line.";
"mini_hurdle_measurement_source_note" = "Full guide image is for training measurement cues; on the field, use the coach-confirmed GT point and a vertical measuring rod.";
"mini_hurdle_measurement_iliac" = "Separate the iliac crest from the GT";
"mini_hurdle_measurement_iliac_hint" = "The GT sits on the lateral proximal femur below the iliac crest. On the athlete, palpate the iliac crest first and then slide down the lateral hip to the GT region.";
"mini_hurdle_measurement_landmark" = "Use rotation to lock onto the GT";
"mini_hurdle_measurement_landmark_hint" = "The bony prominence that rolls with the femur under your fingers and can be found again consistently is the GT landmark";
"mini_hurdle_measurement_vertical" = "Drop GT height to the floor";
"mini_hurdle_measurement_vertical_hint" = "In natural standing, drop a vertical line from the superior GT point to the floor. The overlay shows direction; the measuring tool must stay upright.";
"mini_hurdle_measurement_touch_label" = "Palpate";
"mini_hurdle_measurement_rotate_label" = "Gentle rotation";
"mini_hurdle_measurement_iliac_label" = "Iliac crest border";
"mini_hurdle_measurement_iliac_warning" = "Do not use this as GT";
"mini_hurdle_measurement_slide_label" = "Slide down";
"mini_hurdle_measurement_gt_label" = "GT point";
"mini_hurdle_measurement_vertical_ruler_label" = "Keep rod vertical";
"mini_hurdle_measurement_stand_label" = "Stand tall";
"mini_hurdle_measurement_correct_title" = "Correct: GT point straight down to the standing surface";
"mini_hurdle_measurement_vertical_to_floor" = "Straight down to floor";
"mini_hurdle_measurement_process_1" = "Palpate iliac crest";
"mini_hurdle_measurement_process_2" = "Slide down, confirm GT";
"mini_hurdle_measurement_process_3" = "Drop ruler to floor";
"mini_hurdle_measurement_wrong_iliac_title" = "Do not measure the iliac crest";
"mini_hurdle_measurement_wrong_iliac_body" = "The iliac crest is higher. Use it to orient first, not as the GT point.";
"mini_hurdle_measurement_wrong_diagonal_title" = "Do not measure diagonally";
"mini_hurdle_measurement_wrong_diagonal_body" = "Keep the measuring tool vertical to the floor. Do not trace the shorts seam or outer thigh.";
"mini_hurdle_measurement_illustration_a11y" = "Measurement diagram. Athlete stands naturally, the superior greater-trochanter point is marked on the lateral hip, and the measurement drops vertically to the floor. Do not use the iliac crest and do not measure diagonally along the leg.";
