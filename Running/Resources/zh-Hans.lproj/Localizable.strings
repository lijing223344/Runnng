"mini_hurdle_title" = "小栏架栏距";
"mini_hurdle_home_desc" = "输入 GT 高度，生成 21 栏小栏架递进栏距与现场摆放点。";
"mini_hurdle_hero_title" = "输入 GT 高度，生成小栏架摆放点";
"mini_hurdle_desc" = "先量大转子高度，再选择 Mann 默认或 Clark 区间。结果用于现场摆栏和节奏微调，不是医学腿长评估。";
"mini_hurdle_setup_title" = "现场设定";
"mini_hurdle_setup_subtitle" = "输入 GT 高度，选择 Mann 默认或 Clark 区间；先按结果摆栏，再根据节奏、落点和速度质量微调。";
"mini_hurdle_measurement_title" = "先确认 GT 高度";
"mini_hurdle_measurement_subtitle" = "GT 高度指站立时股骨大转子上缘到地面的垂直高度。它用于估算短跑小栏架摆放，不等于裆长，也不能沿大腿外侧斜量。";
"mini_hurdle_measurement_definition_title" = "GT 测量口径";
"mini_hurdle_measurement_definition_body" = "GT 高度 = 大转子上缘到站立地面的垂直高度。骨点找偏会让 21 栏整体偏长或偏短，所以先找准点，再调栏距。";
"mini_hurdle_measurement_partner_title" = "由教练从侧方完成";
"mini_hurdle_measurement_partner_body" = "运动员保持自然站立，教练从侧方或侧后方触诊。不要让运动员自己低头弯腰估点；衣物越贴身，大转子越容易确认。";
"mini_hurdle_measurement_cue_lateral_title" = "髋外侧触诊";
"mini_hurdle_measurement_cue_lateral_body" = "先摸到髂嵴外缘作为定位，再沿髋外侧向下滑到股骨近端外侧的大转子区域。";
"mini_hurdle_measurement_cue_rotation_title" = "内外旋确认";
"mini_hurdle_measurement_cue_rotation_body" = "让运动员小幅髋内旋、外旋。能在指下随股骨一起转动、并能反复找回来的骨点，才作为 GT 点。";
"mini_hurdle_measurement_cue_vertical_title" = "垂直到地面";
"mini_hurdle_measurement_cue_vertical_body" = "量的是大转子点到地面的垂直高度，不沿裤缝或大腿斜量。";
"mini_hurdle_measurement_cue_repeat_title" = "双侧重复测量";
"mini_hurdle_measurement_cue_repeat_body" = "左右各测 2-3 次。若两侧差异明显，先复核骨点，再由教练按训练侧和动作表现决定采用值。";
"mini_hurdle_measurement_step_1" = "运动员自然站立，双脚并列、脚尖朝前，膝不过度弯曲，骨盆不侧倾，重心均匀落在两脚。";
"mini_hurdle_measurement_step_2" = "教练站在侧方或侧后方，先摸髂嵴外缘，再沿髋外侧向下滑，避免把位置更高的骨盆边缘误当成大转子。";
"mini_hurdle_measurement_step_3" = "让运动员做小幅髋内旋、外旋。能在指下明显跟着股骨一起转动、反复都能找回来的骨点，才作为测量所用的大转子点。";
"mini_hurdle_measurement_step_4" = "从已确认的大转子上缘垂直量到地面。尺杆必须竖直；运动员不要屈膝、提髋、踮脚或把身体重心偏到一侧。";
"mini_hurdle_measurement_backup_title" = "触诊不清楚时的复核办法";
"mini_hurdle_measurement_backup_body" = "若站立位仍难确认，可让运动员屈膝约 90°，缓慢做髋内旋，观察大转子何时最外突；确认骨点后，再回到自然站立位完成正式测量。";
"mini_hurdle_measurement_note_title" = "先把点找准，再看小数位";
"mini_hurdle_measurement_note_body" = "大转子点找偏，会把误差放大到每一栏。常见错误是量到髂嵴、沿大腿斜量、身体站歪，或把训练裤缝当作测量线。";
"mini_hurdle_measurement_source_note" = "完整示意图用于训练测量提示；现场仍以教练触诊确认的大转子点和竖直量尺为准。";
"mini_hurdle_measurement_iliac" = "先分清髂嵴与大转子";
"mini_hurdle_measurement_iliac_hint" = "大转子位于股骨近端外侧，位置低于髂嵴外缘；现场应先摸到髂嵴外缘，再沿髋外侧向下滑到大转子区域";
"mini_hurdle_measurement_landmark" = "用内外旋把大转子找准";
"mini_hurdle_measurement_landmark_hint" = "能在指下随股骨一起滚动、重复触诊仍能找回来的骨性突点，才作为 GT 点";
